# Copy this file to .env and fill in the values
PORT=5000
APP_URL=http://localhost:5000

# MongoDB Atlas (free) or local MongoDB
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/dropkit

# Long random string. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=c3f9c5342db2fbaa8a223454712f45ad8add6e55a3548c90489bed2959310ce4ea545a2bb547ef7a185bad3cd7686708

# From Google Cloud Console > APIs & Services > Credentials (see README)
GOOGLE_CLIENT_ID=

# Optional: real password-reset emails. If empty, the reset link is printed in the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DROPKIT <no-reply@yourdomain.com>"
